<?xml version="1.0" encoding="utf-8"?>
<root>
	<styles>
		<include src="s2r://panorama/styles/dotastyles.vcss_c" />
		<include src="file://{resources}/styles/custom_game/draft.css" />
	</styles>
	<scripts><include src="file://{resources}/scripts/custom_game/draft.js" /></scripts>
	<Panel class="DraftRoot" hittest="false">
		<Panel id="DraftBackdrop" class="DraftBackdrop" hittest="false" />
		<Panel id="DraftHeader" class="DraftHeader" hittest="false">
			<Label text="#ai_lod_title" class="Brand" />
			<Label id="Progression" class="Progression" />
		</Panel>
		<Panel id="RadiantRoster" class="TeamRoster Radiant" hittest="false" />
		<Panel id="DireRoster" class="TeamRoster Dire" hittest="false" />
		<Panel id="Lobby" class="PhasePanel" hittest="true">
			<Label text="#ai_lod_lobby" class="PhaseTitle" />
			<Label text="#ai_lod_mode" class="PhaseHint" />
			<Label id="LobbyTimer" class="Timer" />
			<Panel class="TeamColumns">
				<Panel class="LobbyTeam"><Label text="#ai_lod_radiant" class="SectionTitle" /><Panel id="LobbyRadiant" class="PlayerList" /></Panel>
				<Panel class="LobbyTeam"><Label text="#ai_lod_dire" class="SectionTitle" /><Panel id="LobbyDire" class="PlayerList" /></Panel>
			</Panel>
			<Label id="LobbyStatus" class="PhaseHint" />
			<Button id="LobbyReadyBtn" class="GoldButton"><Label text="#ai_lod_ready" /></Button>
		</Panel>
		<Panel id="BanPhase" class="PhasePanel" hittest="true">
			<Label text="#ai_lod_ban" class="PhaseTitle" />
			<Label id="BanTimer" class="Timer" />
			<Label text="#ai_lod_ban_hint" class="PhaseHint" />
			<Panel id="BanAbilityList" class="BanGrid" />
		</Panel>
		<Panel id="HeroSelect" class="PhasePanel" hittest="true">
			<Label text="#ai_lod_hero_draft" class="PhaseTitle" />
			<Label id="HeroTimer" class="Timer" />
			<Label text="#ai_lod_hero_hint" class="PhaseHint" />
			<Panel id="HeroCategories" class="HeroCategories" />
			<Label id="RerollsLeft" class="PhaseHint" />
		</Panel>
		<Panel id="AbilityDraft" class="PhasePanel" hittest="true">
			<Label text="#ai_lod_ability_draft" class="PhaseTitle" />
			<Label id="DraftTimer" class="Timer" />
			<Label text="#ai_lod_basic_hint" class="PhaseHint" />
			<Panel id="DraftRegularList" class="AbilityGrid" />
			<Panel id="DraftPicked" class="BuildStrip" />
		</Panel>
		<Panel id="InitialUltDraft" class="PhasePanel UltimatePanel" hittest="true">
			<Label text="#ai_lod_initial_ultimate" class="PhaseTitle" />
			<Label id="InitialUltTimer" class="Timer" />
			<Label text="#ai_lod_initial_hint" class="PhaseHint" />
			<Panel id="InitialUltChoices" class="AbilityGrid UltimateChoices" />
			<Label id="InitialUltStatus" class="PhaseHint" />
		</Panel>
		<Panel id="UltDraft" class="PhasePanel UltimatePanel" hittest="true">
			<Label text="#ai_lod_bonus_ultimate" class="PhaseTitle" />
			<Label id="UltTimer" class="Timer" />
			<Label id="UltCount" class="PhaseHint" />
			<Panel id="UltChoiceList" class="AbilityGrid UltimateChoices" />
			<Label id="UltSelected" class="PhaseHint" />
			<Button id="UltConfirmBtn" class="GoldButton"><Label text="#ai_lod_lock" /></Button>
		</Panel>
		<Panel id="BuildConfirmation" class="PhasePanel" hittest="true">
			<Label text="#ai_lod_build_confirmation" class="PhaseTitle" />
			<Label id="BuildTimer" class="Timer" />
			<Label text="#ai_lod_build_hint" class="PhaseHint" />
			<Panel id="FinalBuild" class="BuildStrip FinalBuild" />
			<Label id="BuildError" class="PhaseHint" />
			<Button id="BuildConfirmBtn" class="GoldButton"><Label text="#ai_lod_confirm_build" /></Button>
		</Panel>
		<Panel id="Preparation" class="PhasePanel PreparationPanel" hittest="true">
			<Label id="PreparationTitle" class="PhaseTitle" />
			<Label id="PreparationTimer" class="Timer" />
			<Label id="PreparationHint" class="PhaseHint" />
			<Panel id="StrategyBuild" class="BuildStrip" />
			<Label id="StrategyGold" class="PhaseHint" />
			<Panel id="StrategyLanes" class="LaneChoices">
				<Label text="#ai_lod_lane" class="LaneHeading" />
				<Button id="LaneTop" class="SmallButton"><Label text="#ai_lod_lane_top" /></Button>
				<Button id="LaneMid" class="SmallButton"><Label text="#ai_lod_lane_mid" /></Button>
				<Button id="LaneBottom" class="SmallButton"><Label text="#ai_lod_lane_bottom" /></Button>
				<Button id="LaneJungle" class="SmallButton"><Label text="#ai_lod_lane_jungle" /></Button>
			</Panel>
			<Panel id="IntroductionPlayers" class="TeamColumns" />
			<Button id="StrategyReadyBtn" class="GoldButton"><Label text="#ai_lod_strategy_ready" /></Button>
		</Panel>
		<Panel id="ChosenBuild" class="ChosenBuild" hittest="true">
			<Label text="#ai_lod_your_build" class="SectionTitle" />
			<Panel id="ChosenBuildSlots" class="BuildStrip" />
			<Panel id="BannedPortraits" class="BannedStrip" />
		</Panel>
		<Panel id="DeathDraft" class="PhasePanel DeathPanel" hittest="true">
			<Panel class="DeathHeading"><Label text="#ai_lod_respawn_draft" class="PhaseTitle" /><Label id="DeathTimer" class="Timer" /></Panel>
			<Label text="#ai_lod_death_hint" class="PhaseHint" />
			<Label text="#ai_lod_basics" class="SectionTitle" /><Panel id="DeathBasicSlots" class="AbilityGrid" />
			<Label text="#ai_lod_ultimates" class="SectionTitle" /><Panel id="DeathUltimateSlots" class="AbilityGrid" />
			<Label id="DeathOfferTitle" class="SectionTitle" />
			<Panel id="DeathBasicOffers" class="AbilityGrid" /><Panel id="DeathUltimateOffers" class="AbilityGrid" />
			<Label id="DeathEmpty" text="#ai_lod_no_replacements" class="PhaseHint" />
			<Label text="#ai_lod_death_timeout" class="PhaseHint" />
			<Label id="DeathLoading" text="#ai_lod_loading_resources" class="PhaseHint" />
			<Label id="DeathDraftError" class="Error" /><Label id="DeathRerolls" class="PhaseHint" />
			<Panel class="DeathActions">
				<Button id="DeathKeepSlotBtn" class="SmallButton"><Label text="#ai_lod_keep_slot" /></Button>
				<Button id="DeathRerollBtn" class="SmallButton"><Label text="#ai_lod_reroll" /></Button>
			</Panel>
			<Panel class="DeathActions">
				<Button id="DeathConfirmBtn" class="GoldButton"><Label text="#ai_lod_replace" /></Button>
				<Button id="DeathSkipBtn" class="GoldButton"><Label text="#ai_lod_skip" /></Button>
			</Panel>
		</Panel>
		<Panel id="MatchResults" class="PhasePanel" hittest="true">
			<Label id="ResultTitle" text="#ai_lod_match_complete" class="PhaseTitle" />
			<Label id="ResultMVP" class="SectionTitle" /><Label id="ResultRunnerUp" class="SectionTitle" />
			<Label text="#ai_lod_score_hint" class="PhaseHint" />
			<Panel id="ResultRows" class="Scoreboard" />
			<Button id="ResultsCloseBtn" class="GoldButton"><Label text="#ai_lod_results_close" /></Button>
		</Panel>
		<Panel id="DeathrollNotice" class="DeathrollNotice" hittest="false"><Label id="DeathrollText" /></Panel>
	</Panel>
</root>
