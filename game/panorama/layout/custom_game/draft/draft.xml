<?xml version="1.0" encoding="utf-8"?>
<root>
	<styles>
		<include src="s2r://panorama/styles/dotastyles.vcss_c" />
		<include src="file://{resources}/styles/custom_game/draft.css" />
	</styles>
	<scripts>
		<include src="file://{resources}/scripts/custom_game/draft.js" />
	</scripts>
	<Panel class="DraftRoot" hittest="false">

		<Panel id="BanPhase" class="PhasePanel" hittest="true">
			<Label text="#ai_lod_ban" class="PhaseTitle"/>
			<Label id="BanTimer" class="Timer" text=""/>
			<Label text="Ban 1 hero from the full pool (server-validated)" class="PhaseHint"/>
			<Panel id="BanAbilityList" class="AbilityGrid"/>
		</Panel>

		<Panel id="HeroSelect" class="PhasePanel" hittest="true">
			<Label text="#ai_lod_hero_draft" class="PhaseTitle"/>
			<Label id="HeroTimer" class="Timer" text=""/>
			<Label text="Random 3x4 offers — pick 1 hero (1 reroll per category)" class="PhaseHint"/>
			<Panel id="HeroCategories" class="HeroCategories"/>
			<Label id="RerollsLeft" text=""/>
		</Panel>

		<Panel id="AbilityDraft" class="PhasePanel" hittest="true">
			<Label text="#ai_lod_ability_draft" class="PhaseTitle"/>
			<Label id="DraftTimer" class="Timer" text=""/>
			<Label text="Choose 3 basic skills, then 1 initial ultimate" class="PhaseHint"/>
			<Label text="Regular abilities" class="SectionTitle"/>
			<Panel id="DraftRegularList" class="AbilityGrid"/>
			<Label text="Ultimates" class="SectionTitle"/>
			<Panel id="DraftUltimateList" class="AbilityGrid"/>
			<Panel id="DraftPicked" class="PickedPanel"/>
		</Panel>

		<Panel id="UltDraft" class="PhasePanel" hittest="true">
			<Label text="#ai_lod_ultimate_draft" class="PhaseTitle"/>
			<Label id="UltTimer" class="Timer" text=""/>
			<Label text="Choose a 2nd ultimate (6 options) then Confirm lock" class="PhaseHint"/>
			<Panel id="UltChoiceList" class="AbilityGrid"/>
			<Label id="UltSelected" text="" class="PhaseHint"/>
			<Button id="UltConfirmBtn" class="ConfirmButton">
				<Label text="Confirm Lock"/>
			</Button>
			<Button id="UltCloseBtn" class="ConfirmButton" enabled="false">
				<Label text="Close after confirmation"/>
			</Button>
		</Panel>

		<Panel id="Preparation" class="PhasePanel PreparationPanel" hittest="true">
			<Label id="PreparationTitle" text="Strategy" class="PhaseTitle"/>
			<Label id="PreparationTimer" class="Timer" text=""/>
			<Label id="PreparationHint" text="" class="PhaseHint"/>
			<Panel id="IntroductionPlayers" class="AbilityGrid"/>
			<Button id="StrategyReadyBtn" class="ConfirmButton">
				<Label text="Ready — finished shopping"/>
			</Button>
		</Panel>

		<Panel id="DeathDraft" class="PhasePanel" hittest="true">
			<Label text="#ai_lod_respawn_draft" class="PhaseTitle"/>
			<Label id="DeathTimer" class="Timer" text=""/>
			<Label text="Stage any number of same-type replacements, then confirm your 3 basics + 2 ultimates." class="PhaseHint"/>
			<Label text="Basic slots" class="SectionTitle"/>
			<Panel id="DeathBasicSlots" class="AbilityGrid"/>
			<Label text="Ultimate slots" class="SectionTitle"/>
			<Panel id="DeathUltimateSlots" class="AbilityGrid"/>
			<Label id="DeathOfferTitle" text="Select a slot to see replacement offers" class="SectionTitle"/>
			<Panel id="DeathBasicOffers" class="AbilityGrid"/>
			<Panel id="DeathUltimateOffers" class="AbilityGrid"/>
			<Label text="Rerolling clears staged changes. Timeout keeps your original loadout." class="PhaseHint"/>
			<Label id="DeathDraftError" text="" class="PhaseHint"/>
			<Label id="DeathRerolls" text="" class="PhaseHint"/>
			<Panel class="DeathActions" hittest="true">
				<Button id="DeathKeepSlotBtn" class="ConfirmButton" enabled="false">
					<Label text="Keep original in selected slot"/>
				</Button>
				<Button id="DeathRerollBtn" class="ConfirmButton">
					<Label id="DeathRerollLabel" text="Reroll both pools"/>
				</Button>
				<Button id="DeathConfirmBtn" class="ConfirmButton">
					<Label text="Confirm loadout"/>
				</Button>
			</Panel>
		</Panel>

		<Panel id="MatchResults" class="PhasePanel" hittest="true">
			<Label id="ResultTitle" text="Match complete" class="PhaseTitle"/>
			<Label text="Gameplay ended — final results" class="PhaseHint"/>
			<Label id="ResultMVP" text="" class="SectionTitle"/>
			<Label id="ResultRunnerUp" text="" class="SectionTitle"/>
			<Label text="MVP score = kills + assists - deaths; ties: hero damage, then player ID." class="PhaseHint"/>
			<Panel id="ResultRows" class="Scoreboard"/>
			<Button id="ResultsCloseBtn" class="ConfirmButton">
				<Label text="Close — use Dota's post-game menu to return"/>
			</Button>
		</Panel>

		<Panel id="DeathrollNotice" class="DeathrollNotice">
			<Label text="#lod_deathroll" class="DeathrollTitle"/>
			<Label id="DeathrollText" text=""/>
		</Panel>

	</Panel>
</root>
